# Copy to .env and fill in. .env is git-ignored; never commit real keys.
#
# The app does not read this file itself. Load it into your shell before running anything:
#   set -a; source .env; set +a
#   ./gradlew bootRun
# docker compose reads .env on its own for the POSTGRES_* values.
#
# Use keys made for this project, not your main account keys: an Anthropic key from a
# dedicated workspace with a spend limit, and an OpenAI project key with a budget. Anything an
# agent can read in this shell, a prompt injection can exfiltrate.
#
# With these exported, ./gradlew test and ./gradlew build still make no billed calls: the tests
# that would are tagged and only run via ./gradlew liveTest / ragEval -PallowBilledCalls=true.

# Required for bootRun: Claude (query generation, /ask answers, reranking, query rewrite)
ANTHROPIC_API_KEY=sk-ant-replace-me
# Required for bootRun: OpenAI embeddings (indexing, semantic and hybrid search)
OPENAI_API_KEY=sk-replace-me

# Optional: the 'typesafe' decisions provider (search.rag.decisions.*). Leave unset to keep it
# off; any placeholder works for a local Laya or Nimble model.
# TYPESAFE_API_KEY=

# Optional model and caching overrides (defaults shown)
# ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
# RAG_QUERY_REWRITE_MODEL=claude-haiku-4-5
# ANTHROPIC_PROMPT_CACHING_ENABLED=true
# ANTHROPIC_PROMPT_CACHING_STRATEGY=SYSTEM_AND_TOOLS

# PostgreSQL chat memory (docker-compose.yml and the app both default to postgres/postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OpenTelemetry export target (the lgtm service in docker-compose.yml)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
