          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "title": "JVM Heap Memory",
      "type": "timeseries",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"ai-powered-search\",area=\"heap\"}",
          "legendFormat": "Used ({{id}})",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{job=\"ai-powered-search\",area=\"heap\"}",
          "legendFormat": "Committed ({{id}})",
          "refId": "B"
        },
        {
          "expr": "jvm_memory_max_bytes{job=\"ai-powered-search\",area=\"heap\"}",
          "legendFormat": "Max ({{id}})",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": {"uid": "prometheus", "type": "prometheus"},
