      "id": 400,
      "title": "JVM Memory",
      "type": "row"
    },
    {
      "datasource": {"uid": "prometheus", "type": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
